# =============================================================================
# Oracle MCP Chatbot - environment template
# =============================================================================
# Copy to .env and fill in. NEVER commit .env.
# In production, source these from HashiCorp Vault / OCI Vault / AWS Secrets
# Manager / Kubernetes Secrets rather than a file on disk.
# =============================================================================

# -----------------------------------------------------------------------------
# Server scope
# -----------------------------------------------------------------------------
# Which database profile this server process serves: onprem | atp | both
# Run TWO servers in production (one onprem, one atp).
# Use "both" only for the optional reconciliation server that needs cross-DB compare.
ORACLE_MCP_PROFILE=onprem

# stdio (local desktop client) | http (containerised / remote)
ORACLE_MCP_TRANSPORT=stdio
ORACLE_MCP_HTTP_HOST=127.0.0.1
ORACLE_MCP_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# Guardrails (defence in depth - these are hard ceilings, users cannot raise them)
# -----------------------------------------------------------------------------
ORACLE_MCP_MAX_ROWS=500
ORACLE_MCP_QUERY_TIMEOUT_SECONDS=30
ORACLE_MCP_MAX_SQL_LENGTH=20000
ORACLE_MCP_ALLOW_CARTESIAN=false
ORACLE_MCP_SAMPLE_ROW_LIMIT=20
# Optional EXPLAIN PLAN pre-flight; rejects plans above this cost. 0 = disabled.
# Requires a PLAN_TABLE visible to the read-only user.
ORACLE_MCP_MAX_PLAN_COST=0

# How the caller's role is established:
#   env      -> role is pinned by ORACLE_MCP_PINNED_ROLE; tool arguments cannot change it (MOST SECURE)
#   argument -> role comes from the tool argument (DEV/DEMO ONLY - the LLM can assert any role)
ORACLE_MCP_ROLE_BINDING_MODE=env
ORACLE_MCP_PINNED_ROLE=business_user
ORACLE_MCP_PINNED_USER_ID=svc_chatbot

# -----------------------------------------------------------------------------
# Policy (allowlists / RBAC / masking)
# -----------------------------------------------------------------------------
ORACLE_MCP_POLICY_DIR=config/policy

# -----------------------------------------------------------------------------
# Audit
# -----------------------------------------------------------------------------
# file | db | both | none
ORACLE_MCP_AUDIT_SINK=file
ORACLE_MCP_AUDIT_FILE=logs/audit.jsonl
# Profile whose connection owns the CHATBOT_AUDIT_LOG table when sink includes "db"
ORACLE_MCP_AUDIT_DB_PROFILE=onprem
ORACLE_MCP_AUDIT_TABLE=CHATBOT_AUDIT.CHATBOT_AUDIT_LOG
ORACLE_MCP_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# EIM data-quality framework
# -----------------------------------------------------------------------------
ORACLE_MCP_DQ_CATALOG_DATABASE=ONPREM
ORACLE_MCP_DQ_CATALOG_SCHEMA=EIM
ORACLE_MCP_DQ_CATALOG_TABLE=EIM_DQ_RULES_LOOKUP
ORACLE_MCP_DQ_HISTORY_FILE=logs/dq-history.jsonl
ORACLE_MCP_DQ_MAX_RULES=200

# =============================================================================
# ON-PREM ORACLE DATABASE
# =============================================================================
ONPREM_ENABLED=true
ONPREM_DISPLAY_NAME=On-Prem Oracle DB
ONPREM_USER=CHATBOT_RO
ONPREM_PASSWORD=change-me
ONPREM_HOST=oracle-onprem.internal.example.com
ONPREM_PORT=1521
ONPREM_SERVICE_NAME=CDMPRD
# Optional: full DSN / EZConnect string. If set, overrides HOST/PORT/SERVICE_NAME.
# TCPS example:
# ONPREM_DSN=tcps://oracle-onprem.internal.example.com:2484/CDMPRD?ssl_server_dn_match=true
ONPREM_DSN=
# thin (default, no Oracle Client needed) | thick (needs Instant Client, for legacy auth/features)
ONPREM_MODE=thin
# Only for thick mode
ONPREM_LIB_DIR=
# Only if on-prem listener uses TCPS with a wallet
ONPREM_WALLET_DIR=
ONPREM_WALLET_PASSWORD=
ONPREM_CONFIG_DIR=
ONPREM_POOL_MIN=1
ONPREM_POOL_MAX=4
ONPREM_POOL_INCREMENT=1
ONPREM_POLICY_FILE=onprem.yaml

# =============================================================================
# ORACLE AUTONOMOUS TRANSACTION PROCESSING (ATP)
# =============================================================================
# Pick ONE of the two connection styles below. They are mutually exclusive:
# setting a wallet directory alongside a TLS-only descriptor makes the driver
# look for an ewallet.pem that does not exist.
ATP_ENABLED=true
ATP_DISPLAY_NAME=Oracle ATP
ATP_USER=CHATBOT_RO
ATP_PASSWORD=change-me
ATP_MODE=thin
ATP_LIB_DIR=
ATP_POOL_MIN=1
ATP_POOL_MAX=4
ATP_POOL_INCREMENT=1
ATP_POLICY_FILE=atp.yaml

# -----------------------------------------------------------------------------
# STYLE A — TLS only (no wallet, one-way TLS)
# -----------------------------------------------------------------------------
# Take the connect string from the OCI console "TLS" tab. If you were given a
# JDBC URL, strip the leading "jdbc:oracle:thin:@" and keep the descriptor from
# "(description=" onward. Quote it: it contains characters the shell would eat.
#
# ATP_DSN='(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=<host>.oci.example.com))(connect_data=(service_name=<id>_<db>_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))'
# ATP_WALLET_DIR=
# ATP_CONFIG_DIR=
# ATP_WALLET_PASSWORD=
#
# Keep ssl_server_dn_match=yes. Setting it to "no" disables verification that
# the certificate belongs to the host you dialled, which removes the protection
# TLS provides against an interposed server.

# -----------------------------------------------------------------------------
# STYLE B — mTLS with a wallet
# -----------------------------------------------------------------------------
# TNS alias from the wallet's tnsnames.ora. Prefer _low, or a dedicated
# consumer-group service, so chatbot traffic cannot starve production workloads.
ATP_DSN=myatp_low
# Directory holding the UNZIPPED wallet.
#   Thin mode needs: tnsnames.ora + ewallet.pem
#   Thick mode needs: cwallet.sso (+ sqlnet.ora)
ATP_WALLET_DIR=/opt/oracle/wallets/atp
ATP_CONFIG_DIR=/opt/oracle/wallets/atp
# Password set when the wallet zip was downloaded (decrypts ewallet.pem). Thin mode only.
ATP_WALLET_PASSWORD=change-me

# =============================================================================
# STANDALONE CHAT UI (python -m oracle_mcp.chat)
# =============================================================================
# Browser UI independent of Cursor. Binds loopback by default.
ORACLE_MCP_CHAT_HOST=127.0.0.1
ORACLE_MCP_CHAT_PORT=8500
# OpenAI-compatible Chat Completions endpoint. A corporate gateway works if it
# speaks the same protocol. The API key never goes to the browser.
#
# Paste the real key. Placeholder values ("...", "change-me", "xxx") are treated
# as unset, so the chat endpoint fails fast at startup instead of at first use.
ORACLE_MCP_LLM_BASE_URL=https://api.openai.com/v1
ORACLE_MCP_LLM_API_KEY=
ORACLE_MCP_LLM_MODEL=gpt-4o
ORACLE_MCP_LLM_TIMEOUT_SECONDS=120
